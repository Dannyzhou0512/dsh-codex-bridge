{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "declaration": true,
    "composite": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/index.ts",
    "src/shared.ts",
    "src/runtime.ts",
    "src/config.ts"
  ]
}
